{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the com-junkawasaki org of this workspace (same shape as
 ;; gftd-talent-actor / cloud-itonami deps.edn).
 ;;
 ;; kotoba-lang/org-oasis-open-xmile is the real simulation engine underneath
 ;; the SD-LLM advisor's proposals and the ScenarioGovernor's structural +
 ;; plausibility checks — pinned by :git/sha at its current main HEAD
 ;; (no sibling checkout needed; a plain git dependency, resolved over
 ;; network like org-oasis-open-xmile's own dsl-core dep).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/org-oasis-open-xmile
        {:git/sha "3930c70b52611dee6aa75910b02010e1cb657c6f"}
        ;; kotoba.net.jvm-host is the ONE namespace in this workspace allowed
        ;; to touch java.net.http; yosoku.deploy's langchain :http-fn goes
        ;; through it instead of hand-rolling the JDK client. Pinned as an
        ;; explicit floor (tools.deps takes the NEWEST sha it is shown, and
        ;; there is no gate on deps.edn pins the way verify-west-pins guards
        ;; west): kotoba-lang/kotoba-net main tip, 2026-09-08.
        io.github.kotoba-lang/kotoba-net
        {:git/sha "251dc4278f21dce4aa4056afdd8fdca0d1097445"}
        org.clojure/data.json {:mvn/version "2.5.1"}} ; yosoku.deploy real-LLM json (same as tashikame/kouhou)
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; clojure -M:dev:run  → drive the demo scenarios through one ScenarioActor
  :run {:main-opts ["-m" "yosoku.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
